{
  "name": "init",
  "description": "Initialize a project: creates .semkit/config.toml in the target directory.\n\nAn initialized project is left as it is without --force.\nWith --dry-run nothing is written.\n\nExample: semkit init --name demo",
  "options": [
    {
      "name": "--name",
      "arguments": [
        {
          "name": "NAME",
          "required": true,
          "arity": {
            "maximum": 1
          }
        }
      ],
      "description": "Project name (defaults to directory name).",
      "metadata": [
        {
          "name": "x-rb-type",
          "value": "str"
        },
        {
          "name": "x-rb-default",
          "value": null
        }
      ]
    },
    {
      "name": "--force",
      "description": "Overwrite an already-initialized project's config.",
      "metadata": [
        {
          "name": "x-rb-type",
          "value": "boolean"
        },
        {
          "name": "x-rb-default",
          "value": false
        }
      ]
    },
    {
      "name": "--json",
      "description": "Emit machine-readable JSON output.",
      "metadata": [
        {
          "name": "x-rb-type",
          "value": "boolean"
        },
        {
          "name": "x-rb-default",
          "value": false
        }
      ]
    },
    {
      "name": "--quiet",
      "description": "Suppress non-essential output.",
      "metadata": [
        {
          "name": "x-rb-type",
          "value": "boolean"
        },
        {
          "name": "x-rb-default",
          "value": false
        }
      ]
    },
    {
      "name": "--verbose",
      "description": "Emit extra diagnostic output.",
      "metadata": [
        {
          "name": "x-rb-type",
          "value": "boolean"
        },
        {
          "name": "x-rb-default",
          "value": false
        }
      ]
    },
    {
      "name": "--dry-run",
      "description": "Show what would happen without making changes.",
      "metadata": [
        {
          "name": "x-rb-type",
          "value": "boolean"
        },
        {
          "name": "x-rb-default",
          "value": false
        }
      ]
    }
  ]
}
