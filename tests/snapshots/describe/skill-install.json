{
  "name": "install",
  "description": "Copy this CLI's bundled skills into an AI tool's skill directory.\n\nThe conventions skill and every extra skill the package ships, each into its own directory.\n\nWith --dry-run nothing is written.\n\nExample: semkit skill install --tool claude-code",
  "options": [
    {
      "name": "--tool",
      "arguments": [
        {
          "name": "TOOL",
          "required": true,
          "arity": {
            "maximum": 1
          }
        }
      ],
      "description": "Target AI tool: one of claude-code, agents.",
      "metadata": [
        {
          "name": "x-rb-type",
          "value": "str"
        },
        {
          "name": "x-rb-default",
          "value": "claude-code"
        }
      ]
    },
    {
      "name": "--project",
      "description": "Install into the current project instead of the user-level directory.",
      "metadata": [
        {
          "name": "x-rb-type",
          "value": "boolean"
        },
        {
          "name": "x-rb-default",
          "value": false
        }
      ]
    },
    {
      "name": "--skill",
      "arguments": [
        {
          "name": "SKILL",
          "required": true,
          "arity": {
            "maximum": 1
          }
        }
      ],
      "description": "Install only this bundled skill (see `skill list`); by default all.",
      "metadata": [
        {
          "name": "x-rb-type",
          "value": "str"
        }
      ]
    },
    {
      "name": "--json",
      "description": "Emit machine-readable JSON output.",
      "metadata": [
        {
          "name": "x-rb-type",
          "value": "boolean"
        },
        {
          "name": "x-rb-default",
          "value": false
        }
      ]
    },
    {
      "name": "--quiet",
      "description": "Suppress non-essential output.",
      "metadata": [
        {
          "name": "x-rb-type",
          "value": "boolean"
        },
        {
          "name": "x-rb-default",
          "value": false
        }
      ]
    },
    {
      "name": "--dry-run",
      "description": "Show what would happen without making changes.",
      "metadata": [
        {
          "name": "x-rb-type",
          "value": "boolean"
        },
        {
          "name": "x-rb-default",
          "value": false
        }
      ]
    }
  ]
}
