      ]
    },
    {
      "name": "--verbose",
      "description": "Emit extra diagnostic output.",
      "metadata": [
        {
          "name": "x-rb-type",
          "value": "boolean"
        },
        {
          "name": "x-rb-default",
          "value": false
        }
      ]
    }
  ]
