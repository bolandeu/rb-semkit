{
  "name": "show",
  "description": "Show the items of a word list, one per line.\n\nAn unknown name exits 2 with the closest names.\n\nExample: semkit lists show @minus/cheap",
  "options": [
    {
      "name": "--json",
      "description": "Emit machine-readable JSON output.",
      "metadata": [
        {
          "name": "x-rb-type",
          "value": "boolean"
        },
        {
          "name": "x-rb-default",
          "value": false
        }
      ]
    },
    {
      "name": "--quiet",
      "description": "Suppress non-essential output.",
      "metadata": [
        {
          "name": "x-rb-type",
          "value": "boolean"
        },
        {
          "name": "x-rb-default",
          "value": false
        }
      ]
    }
  ],
  "arguments": [
    {
      "name": "name",
      "required": true,
      "arity": {
        "minimum": 1,
        "maximum": 1
      },
      "description": "The name of the list, as niche/mebel or @niche/mebel (see `lists`).",
      "metadata": [
        {
          "name": "x-rb-type",
          "value": "str"
        },
        {
          "name": "x-rb-default",
          "value": null
        }
      ]
    }
  ]
}
